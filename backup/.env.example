# Secrets for t3backup.sh and the Makefile. Untracked; see .env.example.
# Plain KEY=value, no quotes: read by both bash and make.

# MinIO client alias `prod` (make install)
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=

# t3-logs ingestion tokens, one per backup unit
T3LOGS_TOKEN_PG_SPC_DEVEL=
T3LOGS_TOKEN_PG_SPC_MAIN=
T3LOGS_TOKEN_PG_TOPGROUP=
T3LOGS_TOKEN_PG_TOPGROUP_EMAILS=
T3LOGS_TOKEN_PG_TOPGROUP_FIT=
T3LOGS_TOKEN_PG_TOPROCK=
T3LOGS_TOKEN_PG_TOPROCK_EMAILS=
T3LOGS_TOKEN_PG_TOPROCK_FIT=
T3LOGS_TOKEN_MINIO_TOPGROUP=
T3LOGS_TOKEN_MINIO_TOPGROUP_EMAILS=
T3LOGS_TOKEN_MINIO_TOPROCK=
T3LOGS_TOKEN_MINIO_TOPROCK_EMAILS=
T3LOGS_TOKEN_GIT_ACCOUNTING_HISTORY=
T3LOGS_TOKEN_GIT_ACCOUNTING_LINTER=
T3LOGS_TOKEN_GIT_DOCKER_DJANGO=
T3LOGS_TOKEN_GIT_SERVER_BACKUP=
T3LOGS_TOKEN_GIT_SERVER_DOTFILES=
T3LOGS_TOKEN_GIT_SERVER_PRODUCTION_2=
T3LOGS_TOKEN_GIT_SERVER_PRODUCTION_3=
T3LOGS_TOKEN_GIT_SUPPORT_KBASE=
T3LOGS_TOKEN_GIT_T3_BACKEND=
T3LOGS_TOKEN_GIT_T3_CLIENTS=
T3LOGS_TOKEN_GIT_T3_FIT=
T3LOGS_TOKEN_GIT_T3_PRICING=
T3LOGS_TOKEN_GIT_T3_SPC=
