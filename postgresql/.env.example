# Copy to .env and set real values. .env is gitignored.
#
# NODE_NAME and TAILSCALE_IP are this node's. Everything else, passwords
# included, must match home3.xyztem.dev/postgresql/.env on idertator-server-03.

# Superuser password. Patroni connects with it, and pg_rewind uses it
# against the primary.
POSTGRES_PASSWORD=changeme

# Host port the container publishes on. Kept the same as the primary's so
# every member is reachable on one port.
POSTGRES_PORT=49187

NODE_NAME=pg02
TAILSCALE_IP=100.78.132.23
ETCD_INITIAL_CLUSTER=pg03=http://100.72.55.106:2380,pg01=http://100.105.195.103:2380,pg02=http://100.78.132.23:2380
ETCD_HOSTS=100.72.55.106:2379,100.105.195.103:2379,100.78.132.23:2379
# Password of the `replicator` role the replica streams with.
REPLICATION_PASSWORD=changeme
# Basic auth for Patroni's REST API, used by patronictl and the other members.
PATRONI_API_PASSWORD=changeme
